EXAM_PREP_APP_NAME=Exam Prep Agent
EXAM_PREP_APP_ENV=development
EXAM_PREP_DEBUG=true
EXAM_PREP_APP_HOST=127.0.0.1
EXAM_PREP_APP_PORT=8000
EXAM_PREP_DEMO_MODE=true
# Leave these unset to use the safer default outside the repo:
# ~/.exam_prep_agent/exam_prep.sqlite3
# ~/.exam_prep_agent/materials
# EXAM_PREP_SQLITE_PATH=
# EXAM_PREP_MATERIAL_STORAGE_PATH=
EXAM_PREP_DEFAULT_LLM_PROVIDER=openai
EXAM_PREP_DEFAULT_LLM_MODEL=gpt-5.4-mini
EXAM_PREP_LLM_API_KEY=
EXAM_PREP_NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
EXAM_PREP_OPENAI_API_BASE_URL=https://api.openai.com/v1
EXAM_PREP_OPENAI_REASONING_EFFORT=none
EXAM_PREP_OPENAI_TEXT_VERBOSITY=low
EXAM_PREP_LLM_REQUEST_TIMEOUT_SECONDS=60
EXAM_PREP_LLM_CONNECT_TIMEOUT_SECONDS=10
EXAM_PREP_LLM_READ_TIMEOUT_SECONDS=90
EXAM_PREP_LLM_WRITE_TIMEOUT_SECONDS=30
EXAM_PREP_LLM_POOL_TIMEOUT_SECONDS=30
EXAM_PREP_LLM_MAX_RETRIES=2
EXAM_PREP_LLM_MAX_CONCURRENT_REQUESTS=1
EXAM_PREP_LLM_ENABLE_RESPONSE_FORMAT=true
EXAM_PREP_LLM_PARSE_MODEL=
EXAM_PREP_LLM_QUIZ_MODEL=
EXAM_PREP_LLM_AGENT_MODEL=
EXAM_PREP_LLM_QUIZ_GENERATION_MODEL=
EXAM_PREP_LLM_QUIZ_EXPLANATION_MODEL=
EXAM_PREP_MAX_SECTION_TOKENS_FOR_PARSE=4000
EXAM_PREP_MAX_CHUNKS_PER_RETRIEVAL=3
EXAM_PREP_MAX_AGENT_CONTEXT_TOKENS=6000
EXAM_PREP_MAX_SECTIONS_PER_UPLOAD=
EXAM_PREP_ENABLE_PARSE_CACHE=true
EXAM_PREP_ENABLE_QUIZ_CACHE=true
EXAM_PREP_ENABLE_WEB_SEARCH=false
EXAM_PREP_FRONTEND_ORIGIN=http://localhost:3000
EXAM_PREP_ENABLE_TORCH_INFERENCE=true
EXAM_PREP_QUESTION_QUALITY_CHECKPOINT_PATH=./backend/artifacts/question_quality_classifier.pt
EXAM_PREP_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=/api/v1
